FROM node:20.18-bullseye-slim AS builder
WORKDIR /usr/src

ARG VITE_API_BASE_URL
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM
ARG VITE_KEYCLOAK_CLIENT_ID
ARG VITE_DEFAULT_PLAY_URI
ARG VITE_DEFAULT_ROOM_URL
ARG VITE_DEFAULT_WORLD_SLUG
ARG VITE_DEFAULT_USER_IDENTIFIER

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL}
ENV VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM}
ENV VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID}
ENV VITE_DEFAULT_PLAY_URI=${VITE_DEFAULT_PLAY_URI}
ENV VITE_DEFAULT_ROOM_URL=${VITE_DEFAULT_ROOM_URL}
ENV VITE_DEFAULT_WORLD_SLUG=${VITE_DEFAULT_WORLD_SLUG}
ENV VITE_DEFAULT_USER_IDENTIFIER=${VITE_DEFAULT_USER_IDENTIFIER}

COPY package.json package-lock.json ./
COPY admin/ui/package.json admin/ui/package.json
RUN npm ci --workspace=@workadventure/admin-ui

COPY admin/ui admin/ui
WORKDIR /usr/src/admin/ui
RUN npm run build

FROM nginx:1.27-alpine
COPY admin/ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /usr/src/admin/ui/dist /usr/share/nginx/html
EXPOSE 80
