# Admin UI/API hosts
ADMIN_DOMAIN=admin.example.com
ADMIN_URL=https://${ADMIN_DOMAIN}
ADMIN_API_URL=https://${ADMIN_DOMAIN}/api

# Admin images
ADMIN_API_IMAGE=your-registry/workadventure-admin-api:latest
ADMIN_UI_IMAGE=your-registry/workadventure-admin-ui:latest

# Admin service auth (must match admin API + play/back)
ADMIN_API_TOKEN=replace-me
ADMIN_SOCKET_JWT_SECRET=replace-me
ADMIN_SOCKET_TTL_SECONDS=900
ADMIN_LOG_LEVEL=info

# Admin database
ADMIN_DB_NAME=workadventure_admin
ADMIN_DB_USER=admin
ADMIN_DB_PASSWORD=replace-me

# Keycloak (same realm as WorkAdventure)
ADMIN_PUBLIC_URL=https://${ADMIN_DOMAIN}
ADMIN_ALLOWED_ORIGINS=https://${ADMIN_DOMAIN}
ADMIN_ALLOWED_DOMAINS=play.example.com
ADMIN_JWT_ISSUER=https://auth.example.com/realms/darna
ADMIN_JWT_AUDIENCE=workadventure-admin
ADMIN_JWT_JWKS_URI=https://auth.example.com/realms/darna/protocol/openid-connect/certs
ADMIN_JWT_RESOURCE=
ADMIN_JWT_ROLE_MAPPING=wa-admin:admin,wa-editor:editor,wa-moderator:moderator,wa-viewer:viewer
ADMIN_JWT_ROLE_CLAIMS=realm_access.roles

# Keycloak admin API (service account)
ADMIN_KEYCLOAK_URL=https://auth.example.com
ADMIN_KEYCLOAK_REALM=darna
ADMIN_KEYCLOAK_CLIENT_ID=workadventure-admin-service
ADMIN_KEYCLOAK_CLIENT_SECRET=replace-me

# Vite build-time vars for the admin UI
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_REALM=darna
VITE_KEYCLOAK_CLIENT_ID=workadventure-admin
VITE_DEFAULT_PLAY_URI=https://play.example.com/@/world/main
VITE_DEFAULT_ROOM_URL=/@/world/main
VITE_DEFAULT_WORLD_SLUG=world
VITE_DEFAULT_USER_IDENTIFIER=admin@example.com

# Admin API expects these names (map from existing .env)
OPENID_WOKA_NAME_POLICY=user_input
JITSI_SECRET=replace-me
